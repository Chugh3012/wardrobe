# Frontend local development environment variables.
# Copy this file to .env.local and fill in your values.
#
#⚠ NEVER commit .env.local — it is already in .gitignore.
#
# For local dev with the real backend (Azure Functions on localhost:7071),
# leave VITE_API_BASE_URL empty so requests go through the Vite proxy.

# API base URL — leave empty for local development (Vite proxies /api/* → localhost:7071)
# Set to the deployed Function App URL only for testing against Azure directly.
VITE_API_BASE_URL=

# Azure AD app registration — required for MSAL login when VITE_SKIP_AUTH is not set.
# Get these from your AAD app registration in the Azure portal.
# VITE_AAD_CLIENT_ID=<your-client-id>
# VITE_AAD_TENANT_ID=<your-tenant-id>

# Set to "true" to skip MSAL authentication entirely (mock user session).
# Only for local UI development when you don't have AAD app access.
VITE_SKIP_AUTH=true

# Application Insights — optional for local dev.
# VITE_APPLICATIONINSIGHTS_CONNECTION_STRING=

# Blob Storage account name — used to build a narrow CSP connect-src/img-src at build time.
# Without this, the production build falls back to the wildcard *.blob.core.windows.net.
# VITE_BLOB_ACCOUNT_NAME=stwardrobeimgdev
